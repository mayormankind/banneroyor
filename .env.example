# Banner Recall — environment template
# Copy to apps/web/.env.local for the web app and apps/worker/.env for the worker.
# Never commit real secrets.

# --- Web: public values (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web: server-only ---
# Service role key is used ONLY in server-side code paths that explicitly need
# it (none by default — user-scoped requests use the anon key + RLS).
SUPABASE_SERVICE_ROLE_KEY=
# OpenAI is called from the web server for grounded recall answers only.
OPENAI_API_KEY=
OPENAI_RECALL_MODEL=gpt-4o-mini
# Max upload size enforced client- and server-side (bytes). Default 2 GiB.
MAX_UPLOAD_BYTES=2147483648
# Signed media URL lifetime for playback (seconds).
MEDIA_URL_TTL_SECONDS=600

# --- Worker ---
WORKER_ENV=development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=meeting-recordings
QUEUE_NAME=meeting-processing
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_INTELLIGENCE_MODEL=gpt-4o-mini

# Worker limits
MAX_JOB_ATTEMPTS=4
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=5
QUEUE_VISIBILITY_TIMEOUT_SECONDS=900
TEMP_DIR=
# Chunking: split audio into chunks of at most this many seconds when the file
# exceeds the provider request limit.
TRANSCRIBE_CHUNK_SECONDS=600
# Intelligence: max transcript characters per analysis chunk.
INTELLIGENCE_CHUNK_CHARS=60000
